# MicroLIMS Backend Environment Variables Example
# Copy this file or configure these variables in your hosting environment (e.g. Render Dashboard).
# NEVER commit real passwords or production keys to source control.

# Database Connection (Neon PostgreSQL in production):
# Render env var name: ConnectionStrings__Default
ConnectionStrings__Default=Host=localhost;Port=5432;Database=LIMSV2;Username=postgres;Password=your_local_password

# JWT Authentication Secret (Must be at least 32 characters / 256 bits):
# Render env var name: Jwt__Key
Jwt__Key=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG

# Allowed Frontend Origins for CORS (Comma or semicolon-separated):
# Render env var name: Frontend__Origin
# Example for Production: http://localhost:5173,https://<your-subdomain>.pages.dev
Frontend__Origin=http://localhost:5173

# Optional: Apply EF Core Migrations on Startup (Default: false)
# Set to 'true' only when deliberately applying migrations to a new/updated database.
# Render env var name: APPLY_MIGRATIONS
APPLY_MIGRATIONS=false

# Port (Set automatically by Render in container hosting):
# PORT=8080

# Optional: SMTP Configuration for Password Reset delivery
Smtp__Host=
Smtp__Port=587
Smtp__Username=
Smtp__Password=
Smtp__FromAddress=no-reply@microlims.local
Smtp__EnableSsl=true
