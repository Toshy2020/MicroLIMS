# Backend
backend/**/bin/
backend/**/obj/
backend/**/*.user
backend/MicroLIMS.API/appsettings.Development.json
backend/MicroLIMS.API/appsettings.Production.json
backend/MicroLIMS.API/appsettings.*.local.json
*.bak
*.backup

# Runtime file-storage output at the repo root only. Anchored with a
# leading slash: a bare "storage/" also matched
# backend/MicroLIMS.Infrastructure/Storage/ on case-insensitive
# filesystems, which silently kept two source files out of the repo.
/storage/
backend/MicroLIMS.API/storage/

# Environment files (keep .env.example)
.env
.env.*
.env*.local
!.env.example
frontend/.env
frontend/.env.*
frontend/.env*.local
!frontend/.env.example

# Frontend
frontend/node_modules/
frontend/dist/
*.tsbuildinfo

# OS/editor/scratch
.vs/
.vscode/
.DS_Store
tree.txt
git_history.txt
MICROLIMS_*.txt
frontend/navigation_audit.txt


# Claude Code worktrees and SDD scratch (git-ignored working state)
.claude/worktrees/
.superpowers/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
