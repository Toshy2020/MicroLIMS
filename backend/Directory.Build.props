<Project>
  <!-- Build settings shared by every backend project (CLAUDE.md Rule 5.1).
       A project only states what is specific to it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Release version: pass -p:MicroLimsVersion=x.y.z to a build or publish. -->
  <PropertyGroup>
    <MicroLimsVersion Condition="'$(MicroLimsVersion)' == ''">0.1.0</MicroLimsVersion>
    <Version>$(MicroLimsVersion)</Version>
    <InformationalVersion>$(MicroLimsVersion)</InformationalVersion>
  </PropertyGroup>
</Project>
