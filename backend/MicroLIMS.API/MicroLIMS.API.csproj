<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Local developer secrets (Jwt:Key) live outside the repository.
         appsettings.Development.json is git-ignored and works too. -->
    <UserSecretsId>microlims-api-dev-secrets</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MicroLIMS.Application\MicroLIMS.Application.csproj" />
    <ProjectReference Include="..\MicroLIMS.Domain\MicroLIMS.Domain.csproj" />
    <ProjectReference Include="..\MicroLIMS.Infrastructure\MicroLIMS.Infrastructure.csproj" />
    <ProjectReference Include="..\MicroLIMS.Persistence\MicroLIMS.Persistence.csproj" />
    <ProjectReference Include="..\MicroLIMS.Shared\MicroLIMS.Shared.csproj" />
  </ItemGroup>
</Project>
