<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Local developer secrets (Jwt:Key) live outside the repository.
         appsettings.Development.json is git-ignored and works too. -->
    <UserSecretsId>microlims-api-dev-secrets</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MicroLIMS.Application\MicroLIMS.Application.csproj" />
    <ProjectReference Include="..\MicroLIMS.Domain\MicroLIMS.Domain.csproj" />
    <ProjectReference Include="..\MicroLIMS.Infrastructure\MicroLIMS.Infrastructure.csproj" />
    <ProjectReference Include="..\MicroLIMS.Persistence\MicroLIMS.Persistence.csproj" />
    <ProjectReference Include="..\MicroLIMS.Shared\MicroLIMS.Shared.csproj" />
  </ItemGroup>
</Project>
