<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <InternalsVisibleTo Include="MicroLIMS.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="BCrypt.Net-Next" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <!-- A copy of frontend/src/tables/tableRegistry.json (the canonical list of table keys). The Docker build context is
         backend/ only, so the backend keeps its own copy; TableKeyRegistryTests fails the build if the two files differ. -->
    <EmbeddedResource Include="Services/TableViews/tableRegistry.json" LogicalName="tableRegistry.json" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MicroLIMS.Domain\MicroLIMS.Domain.csproj" />
    <ProjectReference Include="..\MicroLIMS.Shared\MicroLIMS.Shared.csproj" />
  </ItemGroup>
</Project>
