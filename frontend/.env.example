# MicroLIMS Frontend Environment Configuration Example
# Copy this file to .env or .env.local for local overrides.
# In Cloudflare Pages, configure these in Project Settings -> Environment Variables.

# Local Development:
# VITE_API_BASE_URL=http://localhost:5000/api
# Or when running backend with HTTPS dev certs:
# VITE_API_BASE_URL=https://localhost:65435/api

# Production (Cloudflare Pages -> Render API):
# VITE_API_BASE_URL=https://<your-render-api-name>.onrender.com/api
# (Note: VITE_API_URL is also supported)

VITE_API_BASE_URL=http://localhost:5000/api
