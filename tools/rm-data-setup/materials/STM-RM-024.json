  "tests": [
    {
      "testCode": "RM-DESC",
      "procedure": "Visual check in a clean transparent watch glass. Hygroscopicity: weigh a glass vessel with stopper (m1), add about 2 g sample (m2), stand unstoppered in a climatic cabinet at 25 ± 1 °C for 24 h, stopper and weigh (m3); % increase in mass = (m3 - m2) / (m2 - m1) x 100 (formula as written in the STM). Interpretation: very hygroscopic >= 15%, hygroscopic 2-15%, slightly hygroscopic < 2%.",
      "kind": "general",
      "workflow": "Observation",
      "details": {
        "perContainer": true,
        "sampleG": 2,
        "temperatureC": "25 ± 1",
        "timeH": 24,
        "grades": [
          "USP"
        ],
        "reference": "USP Crospovidone monograph"
      },
      "source": "Crospovidone__STM- RM-0 Crospovidone.txt:42"
    },
    {
      "testCode": "RM-SOLUB",
      "procedure": "Weigh 100 mg in a stoppered tube; add 0.1 mL solvent, shake 1 min, hold at 25.0 ± 0.5 °C for 15 min, repeat shake/hold once if not dissolved; add 0.9 mL, then 2 mL, then 7 mL solvent with the same steps to classify; if still undissolved use 10 mg in 10 mL (slightly soluble), then 1 mg in 10 mL (very slightly soluble), else practically insoluble. Repeat with organic solvents.",
      "kind": "general",
      "workflow": "Qualitative",
      "details": {
        "sample": "100 mg",
        "temperature": "25.0 ± 0.5 °C",
        "holdMin": 15,
        "shakeMin": 1,
        "volumesMl": [
          0.1,
          0.9,
          2,
          7
        ],
        "smallSampleSteps": [
          "10 mg in 10 mL",
          "1 mg in 10 mL"
        ],
        "solvents": [
          "water",
          "organic solvents (not named in the STM text)"
        ],
        "reference": "USP Description and Relative Solubility, Crospovidone"
      },
      "source": "Crospovidone__STM- RM-0 Crospovidone.txt:43"
    },
    {
      "testCode": "RM-ID-IR",
      "procedure": "IR identification: dry the powder in vacuum at 105 °C for 1 h, mix intimately with potassium bromide, compress into a transparent pellet; compare the spectrum with that of Crospovidone RS or WS.",
