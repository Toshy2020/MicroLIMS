  "tests": [
    {
      "testCode": "RM-DESC",
      "procedure": "Under strong white light check each received sample container separately in a clean transparent watch glass or glass dish for foreign particles, colour and conformity with the visual specification. Hygroscopicity: weigh about 2 g in a glass weighing vessel with stopper (m1, m2); stand unstoppered in a climatic cabinet at 25 ± 1 °C for 24 h; stopper and weigh (m3); % increase in mass: very hygroscopic 15% or more; hygroscopic 2% to 15%; slightly hygroscopic less than 2%.",
      "kind": "general",
      "workflow": "Observation",
      "details": {
        "perContainer": true,
        "sample": "about 2 g",
        "cabinetC": "25 ± 1",
        "standH": 24,
        "classes": "very hygroscopic >= 15%; hygroscopic 2-15%; slightly hygroscopic < 2%",
        "reference": "BP (SC IV K.) Characters Section (Hygroscopicity)"
      },
      "source": "Calcium Glycerophosphate__Calcium Glycerophosphate-SM.txt:28"
    },
    {
      "testCode": "RM-SOLUB",
      "procedure": "Weigh 100 mg sample in a stoppered tube; add 0.1 mL solvent, shake 1 min, hold at 25.0 ± 0.5 °C for 15 min, repeat shake/hold once if not dissolved; stepwise add 0.9 mL, 2 mL, 7 mL solvent (same shake and hold) to classify very soluble / freely soluble / soluble / sparingly soluble; if still undissolved use 10 mg in 10 mL (slightly soluble) then 1 mg in 10 mL (very slightly soluble), else practically insoluble. Repeat with ethanol (96 per cent).",
      "kind": "general",
      "workflow": "Qualitative",
      "details": {
        "sample": "100 mg",
        "temperature": "25.0 ± 0.5 °C",
        "holdMin": 15,
        "shakeMin": 1,
        "volumesMl": [0.1, 0.9, 2, 7],
        "smallSampleSteps": ["10 mg in 10 mL", "1 mg in 10 mL"],
        "solvents": ["water", "ethanol (96 per cent)"],
        "reference": "BP (SC IV K.) Characters Section (Hygroscopicity and Solubility)"
      },
      "source": "Calcium Glycerophosphate__Calcium Glycerophosphate-SM.txt:29"
    },
    {
      "testCode": "RM-ID-PIP-CAGLY",
      "procedure": "Identification test 1: mix 1 g with 1 g potassium hydrogen sulfate in a test tube fitted with a glass tube; heat strongly and direct the white vapour onto filter paper impregnated with freshly prepared 10 g/L sodium nitroprusside solution. The paper develops a blue colour in contact with piperidine.",
      "kind": "specific",
      "workflow": "Qualitative",
      "details": {
        "sampleG": 1,
        "reagent": "1 g potassium hydrogen sulfate",
        "paper": "filter paper with 10 g/L sodium nitroprusside",
        "reference": "BP 2024 Monograph for Calcium Glycerophosphate"
      },
      "source": "Calcium Glycerophosphate__Calcium Glycerophosphate-SM.txt:30"
    },
    {
      "testCode": "RM-ID-PO4",
      "procedure": "Identification test 2 (phosphates): ignite 0.1 g in a crucible; take up the residue with 5 mL nitric acid; heat on a water bath 1 min; filter; mix 1 mL of the solution with 2 mL molybdovanadic reagent. A yellow colour develops.",
      "kind": "general",
      "workflow": "Qualitative",
      "details": {
        "sampleG": 0.1,
        "acid": "5 mL nitric acid",
        "waterBathMin": 1,
        "reagent": "2 mL molybdovanadic reagent",
        "reference": "BP Appendix VI, Qualitative Reactions and Tests, phosphates"
      },
      "source": "Calcium Glycerophosphate__Calcium Glycerophosphate-SM.txt:30"
    },
    {
      "testCode": "RM-ID-CA-CAGLY",
      "procedure": "Identification test 3 (calcium): dissolve about 20 mg sample in 5 mL acetic acid; add 0.5 mL potassium ferrocyanide solution (solution remains clear); add about 50 mg ammonium chloride; a white crystalline precipitate is formed.",
      "kind": "specific",
      "workflow": "Qualitative",
      "details": {
        "sample": "about 20 mg",
        "acid": "5 mL acetic acid",
