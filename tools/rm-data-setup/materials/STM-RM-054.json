  "tests": [
    {
      "testCode": "RM-DESC",
      "procedure": "Under strong white light check each received sample container separately in a clean transparent watch glass or glass dish for foreign particles, colour and compliance with the visual specification.",
      "kind": "general",
      "workflow": "Qualitative",
      "details": { "perContainer": true, "grades": ["USP"], "reference": "USP 2024 description and relative solubility" },
      "source": "Fluconazole__STM Fluconazole new - EDA.txt:28"
    },
    {
      "testCode": "RM-SOLUB",
      "procedure": "Stepwise solubility at 25.0 +/- 0.5 C: 100 mg powdered sample in a stoppered tube with 0.1 mL solvent, shake 1 min, hold 15 min; then add 0.9 mL, 2 mL and 7 mL of solvent (same shake and hold) to classify very soluble / freely soluble / soluble / sparingly soluble; if still undissolved, 10 mg in 10 mL (slightly soluble), then 1 mg in 10 mL (very slightly soluble), else practically insoluble. Repeat with methanol, alcohol, isopropanol and toluene.",
      "kind": "general",
      "workflow": "Qualitative",
      "details": {
        "grades": ["USP"],
        "sampleMg": 100,
        "temperatureC": "25.0 +/- 0.5",
        "holdMin": 15,
        "shakeMin": 1,
        "volumesMl": [0.1, 0.9, 2, 7],
        "solvents": ["methanol", "alcohol", "isopropanol", "toluene"],
        "reference": "USP 2024 Description and Relative Solubility"
      },
      "source": "Fluconazole__STM Fluconazole new - EDA.txt:29"
    },
    {
      "testCode": "RM-ID-IR",
