    },
    {
      "testCode": "RM-RS-FLU",
      "procedure": "HPLC organic impurities. Mobile phase acetonitrile and water (20:80). Standard solution: 10 ug/mL each of Fluconazole RS and related compounds A, B and C in acetonitrile, diluted in mobile phase. Sample solution: 3 mg/mL in mobile phase. LC, UV 260 nm, column 4.6 mm x 15 cm, 3.5 um L1, 40 C, 0.5 mL/min, 20 uL. System suitability (standard solution): resolution NLT 1.5 between related compounds B and C; RSD NMT 5.0 % each peak. Related compounds A, B, C (%) = (rU/rS) x (CS/CU) x 100; any unspecified impurity (%) = (rU/rS) x (CS/CU) x 100 using Fluconazole RS.",
      "kind": "specific",
      "workflow": "HplcMethodAssay",
      "details": {
        "grades": ["USP"],
        "mobilePhase": "acetonitrile:water 20:80",
        "standardUgPerMl": 10,
        "sampleMgPerMl": 3,
        "detectorNm": 260,
        "column": "4.6 mm x 15 cm, 3.5 um, L1",
        "columnC": 40,
        "flowMlPerMin": 0.5,
        "injectionUl": 20,
        "sstResolutionNLT": 1.5,
        "sstRsdNMT": 5.0,
        "relativeRetentionTime": {"related compound A": 0.5, "specified impurity": 0.6, "related compound B": 0.81, "related compound C": 0.86, "fluconazole": 1.0},
        "reference": "USP Chromatography <621>, System Suitability"
      },
      "source": "Fluconazole__STM Fluconazole new - EDA.txt:31-40"
    },
    {
      "testCode": "RM-SASH",
      "procedure": "Residue on ignition: ignite empty crucible at 600-650 C and cool in desiccator (W0); weigh 0.5 g sample (W1); moisten with about 1 mL sulfuric acid, heat gently until charred, moisten again, heat until white fumes stop; ignite in muffle at 600-650 C, cool in desiccator, weigh (W2); repeat to constant weight. % = (W2 - W0) / (W1 - W0) x 100.",
      "kind": "general",
      "workflow": "Gravimetric",
      "details": { "grades": ["USP"], "sampleG": 0.5, "muffleC": "600-650", "reference": "USP 2024 Residue on Ignition <281>" },
      "source": "Fluconazole__STM Fluconazole new - EDA.txt:41"
