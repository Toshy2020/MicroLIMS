  "tests": [
    {
      "testCode": "RM-DESC",
      "procedure": "Under strong white light, check each received sample container separately in clean, transparent watch glass or glass dish to detect any foreign particles, conformance of colour & compliance with the visual specifications.",
      "kind": "general",
      "workflow": "Qualitative",
      "details": {
        "perContainer": true,
