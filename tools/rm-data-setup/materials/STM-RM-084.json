      },
      "source": "Lactose Monohydrate__Lactose Monohydrate - SM.txt:30"
    },
    {
      "testCode": "RM-SOLUB",
      "procedure": "Weigh 100 mg of sample in a stoppered tube, add solvent in graduated steps (0.1 mL, 0.9 mL, 2 mL, 7 mL, etc.) with shaking at 25.0 ± 0.5 °C to evaluate solubility according to BP descriptive terms. Repeat steps with ethanol (96 per cent).",
      "kind": "general",
      "workflow": "Qualitative",
      "details": {
        "solvents": [
          "water",
          "ethanol (96 per cent)"
        ],
        "reference": "BP 2025 Monograph for Lactose Monohydrate"
      },
      "source": "Lactose Monohydrate__Lactose Monohydrate - SM.txt:31"
    },
    {
