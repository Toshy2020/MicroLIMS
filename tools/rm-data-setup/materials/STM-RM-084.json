      "kind": "general",
      "workflow": "Qualitative",
      "details": {
        "reference": "BP Appendix II A. Infrared Spectrophotometry"
      },
      "source": "Lactose Monohydrate__Lactose Monohydrate - SM.txt:32"
    },
    {
      "testCode": "RM-ID-TLC-LACTOSE",
      "procedure": "TLC silica gel plate. Solvent mixture: water, methanol (40:60 V/V). Test solution: 10 mg sample diluted to 20 mL with solvent mixture. Reference solution: 10 mg lactose monohydrate WS diluted to 20 mL with solvent mixture. Mobile phase: water, methanol, glacial acetic acid, methylene chloride (10:15:25:50 V/V). Application: 2 uL; dry application points. Double development over 3/4 plate with drying in warm air. Spray with 0.5 g thymol in 5 mL sulfuric acid and 95 mL ethanol (96%), heat at 130 °C for 10 min. Principal spot in test solution similar in position, color and size to reference solution.",
      "kind": "specific",
      "workflow": "Qualitative",
      "details": {
        "stationaryPhase": "TLC silica gel plate",
        "mobilePhase": "water : methanol : glacial acetic acid : methylene chloride (10:15:25:50)",
        "detection": "spray with thymol / sulfuric acid in ethanol, heat at 130 °C for 10 min",
        "reference": "BP Appendix III A. Thin-layer Chromatography"
      },
      "source": "Lactose Monohydrate__Lactose Monohydrate - SM.txt:32"
    },
    {
      "testCode": "RM-ID-CHEM-LACTOSE",
      "procedure": "Dissolve 0.25 g in 5 mL of water. Add 5 mL of ammonia. Heat in a water-bath at 80 °C for 10 min. A red color develops.",
      "kind": "specific",
      "workflow": "Qualitative",
      "details": {
        "sampleG": 0.25,
        "waterMl": 5,
        "ammoniaMl": 5,
        "temperatureC": 80,
        "timeMin": 10,
        "reference": "BP 2025 Monograph for Lactose Monohydrate"
      },
      "source": "Lactose Monohydrate__Lactose Monohydrate - SM.txt:32"
    },
    {
      "testCode": "RM-SOLAPP",
      "procedure": "Compare between two Nessler tubes transparent and same volume. Test Solution Tube Containing Solution S (1.0 g dissolved in boiling water, cooled and diluted to 10.0 mL with water) and the other Containing Solution BY7. Solution S is clear and not more intensely colored than reference solution BY7.",
      "kind": "general",
      "workflow": "Qualitative",
      "details": {
        "reference": "BP Appendix IV B. Color of Solution & Appendix IV A. Clarity of Solution"
      },
      "source": "Lactose Monohydrate__Lactose Monohydrate - SM.txt:33"
    },
    {
      "testCode": "RM-ACID-ALK-LACTOSE",
      "procedure": "Dissolve 6.0 g by heating in 25 mL of carbon dioxide-free water. Cool. Add 0.3 mL of phenolphthalein solution R1. The solution is colorless. Titrate with 0.1 M sodium hydroxide until pink or red; not more than 0.4 mL required.",
      "kind": "specific",
      "workflow": "Measurement",
      "details": {
        "sampleG": 6.0,
        "titrant": "0.1 M Sodium Hydroxide",
        "indicator": "Phenolphthalein Solution R1",
        "reference": "BP 2025 Monograph for Lactose Monohydrate"
      },
      "source": "Lactose Monohydrate__Lactose Monohydrate - SM.txt:34"
    },
    {
      "testCode": "RM-OPTROT",
      "procedure": "Dissolve 10.0 g in 80 mL of water with heating at 50 °C. Allow to cool. Add 0.2 mL of dilute ammonia R1. Allow to stand for 30 min and dilute to 100.0 mL with water. Measure specific optical rotation using calibrated polarimeter. Specification on anhydrous substance: +54.4 to +55.9.",
      "kind": "general",
      "workflow": "Measurement",
      "details": {
        "sampleG": 10.0,
        "volumeMl": 100.0,
        "resultBasis": "anhydrous substance",
        "reference": "BP Appendix V F. Determination of Optical Rotation and Specific Optical Rotation"
      },
      "source": "Lactose Monohydrate__Lactose Monohydrate - SM.txt:35"
    },
    {
      "testCode": "RM-UV-ABS-LACTOSE",
      "procedure": "Test solution (a): Solution S. Test solution (b): Dilute 1.0 mL of test solution (a) to 10.0 mL with water. Measure absorbance using calibrated UV spectrophotometer: at 400 nm for test solution (a) [max 0.04]; from 210 nm to 220 nm for test solution (b) [max 0.25]; from 270 nm to 300 nm for test solution (b) [max 0.07].",
      "kind": "specific",
      "workflow": "UvSpectrophotometry",
      "details": {
        "spectralRanges": [
          "400 nm",
          "210-220 nm",
          "270-300 nm"
        ],
        "reference": "BP Appendix II B. Ultraviolet and Visible Absorption Spectrophotometry"
      },
      "source": "Lactose Monohydrate__Lactose Monohydrate - SM.txt:36"
    },
    {
      "testCode": "RM-KF",
      "procedure": "Determined on 0.50 g, using a mixture of 1 volume of formamide and 2 volumes of methanol as solvent. Measure water content using calibrated Karl Fischer.",
      "kind": "general",
      "workflow": "Measurement",
      "details": {
        "sampleG": 0.5,
        "solvent": "formamide : methanol (1:2)",
        "reference": "BP Appendix IX C. Determination of Water"
      },
      "source": "Lactose Monohydrate__Lactose Monohydrate - SM.txt:37"
    },
    {
      "testCode": "RM-SASH",
      "procedure": "Accurately weigh 1.0 g into empty crucible previously ignited at 600-650 °C (W0, W1). Moisten with ~1 mL sulfuric acid, heat gently on hot plate until charred. Cool, moisten with sulfuric acid, heat until white fumes cease. Ignite in calibrated muffle at 600-650 °C to constant weight (W2). Calculate % Sulfated ash = ((W2 - W0) / (W1 - W0)) * 100.",
      "kind": "general",
      "workflow": "Gravimetric",
      "details": {
        "temperatureC": "600-650",
