  "tests": [
    {
      "testCode": "RM-DESC",
      "procedure": "Under strong white light, check each received sample container separately in clean, transparent watch glass or glass dish to detect any foreign particles, conformance of colour & compliance with the visual specifications.",
      "kind": "general",
      "workflow": "Observation",
      "details": {
        "perContainer": true,
        "specification": "White or almost white, very fine, light powder, greasy to the touch",
        "reference": "BP 2025 Monograph for Magnesium Stearate"
      },
      "source": "Magnesium Stearate__Magnesium Stearate - SM.txt:30"
    },
    {
      "testCode": "RM-SOLUB",
      "procedure": "Weigh 100 mg of sample in a stoppered tube. Stepwise add solvent: 0.1 mL, 0.9 mL, 2 mL, 7 mL with 1 min vigorous shaking and 15 min hold at 25.0 ± 0.5 °C; if undissolved test 10 mg in 10 mL then 1 mg in 10 mL. Repeat with water and anhydrous ethanol.",
      "kind": "general",
      "workflow": "Qualitative",
      "details": {
        "solvents": [
          "water",
          "anhydrous ethanol"
        ],
        "specification": "Practically insoluble in water and in anhydrous ethanol"
      },
      "source": "Magnesium Stearate__Magnesium Stearate - SM.txt:31"
    },
    {
      "testCode": "RM-ID-CR-MG",
      "procedure": "To 1 mL of solution S add 1 mL of dilute ammonia R1. A white precipitate forms that dissolves on addition of 1 mL ammonium chloride solution. Add 1 mL of 120 g/L disodium hydrogen phosphate dodecahydrate solution; a white crystalline precipitate is formed.",
      "kind": "specific",
      "workflow": "Qualitative",
      "details": {
        "sampleSolution": "1 mL solution S (5.0 g refluxed in 50 mL ether + 20 mL dilute HNO3 + 20 mL water, aqueous layer diluted to 50.0 mL)",
        "reagents": [
          "1 mL dilute ammonia R1",
          "1 mL ammonium chloride solution",
          "1 mL 120 g/L disodium hydrogen phosphate"
        ],
        "expected": "White crystalline precipitate is formed",
        "reference": "BP 2025 Monograph for Magnesium Stearate"
      },
      "source": "Magnesium Stearate__Magnesium Stearate - SM.txt:32"
    },
    {
      "testCode": "RM-ID-FP-MG",
      "procedure": "Determined on the residue obtained from evaporating the ether layer in preparation of solution S, dried at 100-105 °C. Insert thermometer in Nessler tube containing the residue, warm on hot plate, record freezing point.",
      "kind": "specific",
      "workflow": "Measurement",
      "details": {
        "sample": "Residue from ether layer of solution S, dried at 100-105 °C",
        "specification": "Minimum 53 °C",
        "reference": "BP Appendix V B. Determination of Freezing Point"
      },
      "source": "Magnesium Stearate__Magnesium Stearate - SM.txt:32"
    },
    {
      "testCode": "RM-ID-AV-MG",
      "procedure": "Dissolve 0.200 g (m) of residue from solution S in 25 mL of neutralized equal parts ethanol (96%) and light petroleum R3, using 0.5 mL phenolphthalein solution R1. Heat to ~90 °C if needed. Titrate with 0.1 M KOH or 0.1 M NaOH until pink color persists for at least 15 s (n mL). Acid value IA = 5.611 x n / m.",
      "kind": "specific",
      "workflow": "Titration",
      "details": {
        "sampleG": 0.2,
        "solvent": "25 mL neutralized ethanol (96%) + light petroleum R3 (1:1)",
        "indicator": "0.5 mL phenolphthalein solution R1",
        "titrant": "0.1 M KOH or 0.1 M NaOH",
        "formula": "IA = 5.611 x n / m",
        "specification": "195 to 210",
        "reference": "BP Appendix X B. Acid Value"
      },
      "source": "Magnesium Stearate__Magnesium Stearate - SM.txt:32"
    },
    {
