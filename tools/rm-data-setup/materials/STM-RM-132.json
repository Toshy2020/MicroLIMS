      "testCode": "RM-ASH-OPRED",
      "procedure": "Accurately weigh empty crucible previously ignited at 600 °C (W1). Weigh accurately ~1.0 g into crucible (W2). Ignite in muffle furnace at 600 ± 50 °C for 2 h. Cool in desiccator. Weigh crucible with residue (W4). Residue weight W3 = W4 - W1. Total ash % = (W3 / W2) x 100.",
      "kind": "specific",
      "workflow": "Gravimetric",
      "details": {
        "sampleG": 1.0,
        "muffleTempC": "600 ± 50",
        "ignitionTimeH": 2,
        "formula": "% total ash = (W3 / W2) x 100; W3 = W4 - W1 (residue wt), W2 = sample wt",
        "reference": "Analytical method verification for ash content in Opadry Red"
      },
      "source": "Opadry Red__STM Opadry Red 3-1.txt:33"
