      },
      "source": "Panthenol__Panthenol - SM 1.txt:31"
    },
    {
      "testCode": "RM-SASH",
      "procedure": "Residue on ignition (USP <281>): weigh an empty crucible previously ignited at 600-650 °C and cooled in desiccator (W0); weigh 1.0 g sample (W1); moisten with a small amount of sulfuric acid, char gently on hot plate, moisten residue again, heat until white fumes cease; ignite in muffle at 600-650 °C, cool in desiccator, weigh (W2); repeat to constant weight. % = (W2 - W0) / (W1 - W0) x 100.",
      "kind": "general",
      "workflow": "Gravimetric",
