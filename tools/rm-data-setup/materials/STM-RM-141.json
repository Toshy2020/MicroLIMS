  "tests": [
    {
      "testCode": "RM-DESC",
      "procedure": "Under strong white light check each received sample container separately in a clean transparent watch glass or glass dish for foreign particles, colour and conformity with the visual specification.",
      "kind": "general",
      "workflow": "Observation",
      "details": {
        "perContainer": true,
        "reference": "USP 2024 Description and Relative Solubility",
        "uspSpecification": "Clear, viscous, somewhat hygroscopic liquid, having a slight, characteristic Odor. Some crystallization may occur on standing."
      },
      "source": "Panthenol__Panthenol - SM 1.txt:28"
    },
    {
      "testCode": "RM-SOLUB",
      "procedure": "Weigh 100 mg sample in a stoppered tube; add 0.1 mL solvent, shake 1 min, hold at 25.0 ± 0.5 °C for 15 min, repeat shake/hold once if not dissolved; stepwise add 0.9 mL, 2 mL, 7 mL solvent (same shake and hold) to classify very soluble / freely soluble / soluble / sparingly soluble; if still undissolved use 10 mg in 10 mL (slightly soluble) then 1 mg in 10 mL (very slightly soluble), else practically insoluble. Repeat with alcohol, methanol, chloroform, ether and glycerin.",
      "kind": "general",
      "workflow": "Qualitative",
      "details": {
        "sample": "100 mg",
        "temperature": "25.0 ± 0.5 °C",
        "holdMin": 15,
        "shakeMin": 1,
        "volumesMl": [0.1, 0.9, 2, 7],
        "smallSampleSteps": ["10 mg in 10 mL", "1 mg in 10 mL"],
        "solvents": ["alcohol", "methanol", "chloroform", "ether", "glycerin"],
        "reference": "USP 2024 Description and Relative Solubility"
      },
      "source": "Panthenol__Panthenol - SM 1.txt:29"
    },
    {
      "testCode": "RM-ID-IR",
      "procedure": "IR identification: mix sample intimately with potassium bromide, compress into a transparent pellet, examine the spectrum and compare with that of D-Panthenol RS.",
