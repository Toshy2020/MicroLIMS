      "kind": "specific",
      "workflow": "Titration",
      "details": {
        "sampleG": 5,
        "blank": "10 mL water",
        "mode": "direct",
        "titrant": "0.01 N sulfuric acid VS",
        "endpoint": "visual, yellow (bromothymol blue TS)",
        "equivalenceFactor": "75.11 mg/mEq",
